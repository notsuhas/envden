{
  "$schema": "./node_modules/fallow/schema.json",
  "includeEntryExports": true,
  "entry": [
    "apps/cli/scripts/{build-all,e2e,smoke,targets}.ts",
    "tools/*/index.ts",
    "scripts/release/{checksums,homebrew-formula,npm-package,publish-channels}.ts"
  ],
  "rules": {
    "circular-dependencies": "error",
    "stale-suppressions": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": ["**/__tests__/**"]
      },
      {
        "name": "core",
        "patterns": ["packages/core/src/**"]
      },
      {
        "name": "testing",
        "patterns": ["packages/testing/src/**"]
      },
      {
        "name": "adapters",
        "patterns": ["packages/adapters/**/src/**"]
      },
      {
        "name": "apps",
        "patterns": ["apps/*/src/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "testing",
        "allow": ["core"]
      },
      {
        "from": "adapters",
        "allow": ["core"]
      },
      {
        "from": "apps",
        "allow": ["core", "adapters"]
      },
      {
        "from": "tests",
        "allow": ["core", "testing", "adapters", "apps", "tests"]
      }
    ]
  },
  "ignoreBinaries": ["tailscale"]
}
