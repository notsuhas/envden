// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`zsh hook snapshot 1`] = `
"# >>> envden >>>
_envden_inside() {
  local directory="$2"
  while [ -n "$directory" ]; do
    [ "$directory" -ef "$1" ] && return 0
    [ "$directory" != / ] || break
    directory="\${directory%/*}"
    [ -n "$directory" ] || directory=/
  done
  return 1
}
_envden_notice() {
  local saved_status=$?
  [ "\${_envden_last_pwd-}" != "$PWD" ] || return "$saved_status"
  _envden_last_pwd="$PWD"
  local physical="\${PWD:A}"
  local root approved=0 cache='/home/test/.envden/state/notice' now modified
  [ -r '/home/test/.envden/state/approved-checkouts' ] && while IFS= read -r root; do
    [ -n "$root" ] || continue
    if _envden_inside "$root" "$physical"; then approved=1; break; fi
  done 2>/dev/null < '/home/test/.envden/state/approved-checkouts'
  local offered='/home/test/.envden/state/track-offered' root_seen=0 day line
  [ -r '/home/test/.envden/state/track-offers' ] && while IFS= read -r root; do
    [ -n "$root" ] || continue
    if _envden_inside "$root" "$physical"; then
      root_seen=0
      [ -r "$offered" ] && while IFS= read -r line; do [ "$line" != "$root" ] || root_seen=1; done 2>/dev/null < "$offered"
      if [ "$root_seen" = 0 ]; then
        printf '%s\\n' 'envden: env files found; run envden track'
        printf '%s\\n' "$root" >> "$offered"
      fi
      break
    fi
  done 2>/dev/null < '/home/test/.envden/state/track-offers'
  day=$(date +%Y-%m-%d)
  [ -r '/home/test/.envden/state/notice-update' ] && while IFS= read -r line; do
    case "$line" in
      'envden: update required; run envden update') printf '%s\\n' "$line" ;;
      'envden: update available; run envden update')
        if [ "$(cat -- '/home/test/.envden/state/update-offered-day' 2>/dev/null)" != "$day" ]; then
          printf '%s\\n' "$line"
          printf '%s\\n' "$day" > '/home/test/.envden/state/update-offered-day'
        fi ;;
    esac
  done 2>/dev/null < '/home/test/.envden/state/notice-update'
  if [ "$approved" = 1 ] && [ -f "$cache" ]; then LC_ALL=C tr -cd '\\11\\12\\40-\\176' < "$cache"; fi
  now=$(date +%s)
  modified=$(stat -c %Y "$cache" 2>/dev/null) || modified=$(stat -f %m "$cache" 2>/dev/null) || modified=0
  if [ "$((now - modified))" -gt 60 ]; then
    (env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden'\\''s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &)
  fi
  return "$saved_status"
}
autoload -Uz add-zsh-hook
add-zsh-hook -d chpwd _envden_notice
add-zsh-hook chpwd _envden_notice
_envden_notice
# <<< envden <<<
"
`;

exports[`bash hook snapshot 1`] = `
"# >>> envden >>>
_envden_inside() {
  local directory="$2"
  while [ -n "$directory" ]; do
    [ "$directory" -ef "$1" ] && return 0
    [ "$directory" != / ] || break
    directory="\${directory%/*}"
    [ -n "$directory" ] || directory=/
  done
  return 1
}
_envden_notice() {
  local saved_status=$?
  [ "\${_envden_last_pwd-}" != "$PWD" ] || return "$saved_status"
  _envden_last_pwd="$PWD"
  local physical="$(pwd -P)"
  local root approved=0 cache='/home/test/.envden/state/notice' now modified
  [ -r '/home/test/.envden/state/approved-checkouts' ] && while IFS= read -r root; do
    [ -n "$root" ] || continue
    if _envden_inside "$root" "$physical"; then approved=1; break; fi
  done 2>/dev/null < '/home/test/.envden/state/approved-checkouts'
  local offered='/home/test/.envden/state/track-offered' root_seen=0 day line
  [ -r '/home/test/.envden/state/track-offers' ] && while IFS= read -r root; do
    [ -n "$root" ] || continue
    if _envden_inside "$root" "$physical"; then
      root_seen=0
      [ -r "$offered" ] && while IFS= read -r line; do [ "$line" != "$root" ] || root_seen=1; done 2>/dev/null < "$offered"
      if [ "$root_seen" = 0 ]; then
        printf '%s\\n' 'envden: env files found; run envden track'
        printf '%s\\n' "$root" >> "$offered"
      fi
      break
    fi
  done 2>/dev/null < '/home/test/.envden/state/track-offers'
  day=$(date +%Y-%m-%d)
  [ -r '/home/test/.envden/state/notice-update' ] && while IFS= read -r line; do
    case "$line" in
      'envden: update required; run envden update') printf '%s\\n' "$line" ;;
      'envden: update available; run envden update')
        if [ "$(cat -- '/home/test/.envden/state/update-offered-day' 2>/dev/null)" != "$day" ]; then
          printf '%s\\n' "$line"
          printf '%s\\n' "$day" > '/home/test/.envden/state/update-offered-day'
        fi ;;
    esac
  done 2>/dev/null < '/home/test/.envden/state/notice-update'
  if [ "$approved" = 1 ] && [ -f "$cache" ]; then LC_ALL=C tr -cd '\\11\\12\\40-\\176' < "$cache"; fi
  now=$(date +%s)
  modified=$(stat -c %Y "$cache" 2>/dev/null) || modified=$(stat -f %m "$cache" 2>/dev/null) || modified=0
  if [ "$((now - modified))" -gt 60 ]; then
    (env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden'\\''s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &)
  fi
  return "$saved_status"
}
case ";\${PROMPT_COMMAND:-};" in *'_envden_notice;'*) ;; *) PROMPT_COMMAND="_envden_notice;\${PROMPT_COMMAND:-}" ;; esac
_envden_notice
# <<< envden <<<
"
`;

exports[`fish hook snapshot 1`] = `
"# >>> envden >>>
function _envden_inside
  set -l directory $argv[2]
  while test -n "$directory"
    if test "$directory" -ef "$argv[1]"
      return 0
    end
    if test "$directory" = /
      break
    end
    set directory (string replace -r '/[^/]*$' '' -- "$directory")
    test -n "$directory"; or set directory /
  end
  return 1
end
function _envden_notice --on-variable PWD
  set -l saved_status $status
  set -l cache '/home/test/.envden/state/notice'
  set -l physical (pwd -P)
  set -l approved 0
  if test -f '/home/test/.envden/state/approved-checkouts'
    while read -l root
      if test -n "$root"; and _envden_inside "$root" "$physical"
        set approved 1
        break
      end
    end < '/home/test/.envden/state/approved-checkouts'
  end
  set -l offered '/home/test/.envden/state/track-offered'
  if test -f '/home/test/.envden/state/track-offers'
    while read -l root
      if test -n "$root"; and _envden_inside "$root" "$physical"
        if not contains -- "$root" (cat -- "$offered" 2>/dev/null)
          printf '%s\\n' 'envden: env files found; run envden track'
          printf '%s\\n' "$root" >> "$offered"
        end
        break
      end
    end < '/home/test/.envden/state/track-offers'
  end
  set -l day (date +%Y-%m-%d)
  if test -f '/home/test/.envden/state/notice-update'
    while read -l line
      switch "$line"
        case 'envden: update required; run envden update'
          printf '%s\\n' "$line"
        case 'envden: update available; run envden update'
          if test (cat -- '/home/test/.envden/state/update-offered-day' 2>/dev/null; or echo missing) != "$day"
            printf '%s\\n' "$line"
            printf '%s\\n' "$day" > '/home/test/.envden/state/update-offered-day'
          end
      end
    end < '/home/test/.envden/state/notice-update'
  end
  if test "$approved" = 1; and test -f "$cache"
    env LC_ALL=C tr -cd '\\11\\12\\40-\\176' < "$cache"
  end
  set -l modified (stat -c %Y "$cache" 2>/dev/null; or stat -f %m "$cache" 2>/dev/null; or echo 0)
  if test (math (date +%s) - "$modified") -gt 60
    env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden\\'s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &
    disown
  end
  return $saved_status
end
_envden_notice
# <<< envden <<<
"
`;

exports[`powershell hook snapshot 1`] = `
"# >>> envden >>>
function _envden_physical_path([string]$path) {
  if (!$path) { return '' }
  $directory = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
  if (!$directory) { return '' }
  if ($directory.LinkType) {
    try { $target = $directory.ResolveLinkTarget($true) } catch { return '' }
    if ($target) { return _envden_physical_path $target.FullName }
  }
  if (!$directory.Parent) { return $directory.FullName }
  $parent = _envden_physical_path $directory.Parent.FullName
  if (!$parent) { return '' }
  return [IO.Path]::Combine($parent, $directory.Name)
}
if (!$global:EnvdenPreviousPrompt) { $global:EnvdenPreviousPrompt = $function:prompt }
function global:prompt {
  $envdenSuccess = $?
  $envdenExitCode = $global:LASTEXITCODE
  $physical = _envden_physical_path ((Get-Location).ProviderPath)
  $insensitive = @(Get-Content -LiteralPath '/home/test/.envden/state/approved-checkouts-insensitive' -ErrorAction SilentlyContinue)
  $cache = '/home/test/.envden/state/notice'
  $approved = @(Get-Content -LiteralPath '/home/test/.envden/state/approved-checkouts' -ErrorAction SilentlyContinue | Where-Object { $_ -and (($physical.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar).StartsWith($_.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar, $(if ($insensitive -ccontains $_) { [StringComparison]::OrdinalIgnoreCase } else { [StringComparison]::Ordinal }))) }).Count -gt 0
  $changed = $global:EnvdenLastDirectory -cne $PWD.Path
  $global:EnvdenLastDirectory = $PWD.Path
  if ($changed) {
    $offered = '/home/test/.envden/state/track-offered'
    foreach ($root in @(Get-Content -LiteralPath '/home/test/.envden/state/track-offers' -ErrorAction SilentlyContinue)) {
      if ($root -and (($physical.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar).StartsWith($root.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar, [StringComparison]::Ordinal))) {
        if (@(Get-Content -LiteralPath $offered -ErrorAction SilentlyContinue) -cnotcontains $root) {
          Write-Host 'envden: env files found; run envden track'
          Add-Content -LiteralPath $offered -Value $root
        }
        break
      }
    }
    $day = (Get-Date).ToString('yyyy-MM-dd')
    $dayFile = '/home/test/.envden/state/update-offered-day'
    foreach ($line in @(Get-Content -LiteralPath '/home/test/.envden/state/notice-update' -ErrorAction SilentlyContinue)) {
      if ($line -ceq 'envden: update required; run envden update') { Write-Host $line }
      if ($line -ceq 'envden: update available; run envden update' -and (Get-Content -LiteralPath $dayFile -ErrorAction SilentlyContinue) -cne $day) {
        Write-Host $line
        Set-Content -LiteralPath $dayFile -Value $day
      }
    }
    if ($approved -and (Test-Path -LiteralPath $cache)) { Get-Content -LiteralPath $cache | ForEach-Object { $_ -replace '[^\\x20-\\x7E]', '' } | Out-Host }
    if (!(Test-Path -LiteralPath $cache) -or ((Get-Date) - (Get-Item -LiteralPath $cache).LastWriteTime).TotalSeconds -gt 60) {
      $info = [Diagnostics.ProcessStartInfo]::new('/opt/envden''s bin/envden')
      $info.Arguments = 'status --refresh-cache'
      $info.UseShellExecute = $false; $info.CreateNoWindow = $true
      $info.Environment.Remove('BUN_OPTIONS'); $info.Environment.Remove('BUN_BE_BUN')
      $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true
      $process = [Diagnostics.Process]::Start($info)
      $process.Dispose()
    }
  }
  $global:LASTEXITCODE = $envdenExitCode
  if (!$envdenSuccess) { Write-Error 'Previous command failed' -ErrorAction Ignore }
  & $global:EnvdenPreviousPrompt
}
# <<< envden <<<
"
`;
