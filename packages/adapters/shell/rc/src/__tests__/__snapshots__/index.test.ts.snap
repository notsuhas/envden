// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`zsh hook snapshot 1`] = `
"# >>> envden >>>
_envden_notice() {
  local root approved=0 cache='/home/test/.envden/state/notice' now modified
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    case "$PWD/" in "$root/"*) approved=1; break ;; esac
  done < '/home/test/.envden/state/approved-checkouts' 2>/dev/null
  [ "$approved" = 1 ] || return 0
  [ ! -f "$cache" ] || cat -- "$cache"
  now=$(date +%s)
  modified=$(stat -f %m "$cache" 2>/dev/null) || modified=$(stat -c %Y "$cache" 2>/dev/null) || modified=0
  if [ "$((now - modified))" -gt 60 ]; then
    (env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden'\\''s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &)
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook -d chpwd _envden_notice
add-zsh-hook chpwd _envden_notice
_envden_notice
# <<< envden <<<
"
`;

exports[`bash hook snapshot 1`] = `
"# >>> envden >>>
_envden_notice() {
  local root approved=0 cache='/home/test/.envden/state/notice' now modified
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    case "$PWD/" in "$root/"*) approved=1; break ;; esac
  done < '/home/test/.envden/state/approved-checkouts' 2>/dev/null
  [ "$approved" = 1 ] || return 0
  [ ! -f "$cache" ] || cat -- "$cache"
  now=$(date +%s)
  modified=$(stat -f %m "$cache" 2>/dev/null) || modified=$(stat -c %Y "$cache" 2>/dev/null) || modified=0
  if [ "$((now - modified))" -gt 60 ]; then
    (env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden'\\''s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &)
  fi
}
case ";\${PROMPT_COMMAND:-};" in *'_envden_notice;'*) ;; *) PROMPT_COMMAND="_envden_notice;\${PROMPT_COMMAND:-}" ;; esac
_envden_notice
# <<< envden <<<
"
`;

exports[`fish hook snapshot 1`] = `
"# >>> envden >>>
function _envden_notice --on-variable PWD
  set -l cache '/home/test/.envden/state/notice'
  set -l approved 0
  if test -f '/home/test/.envden/state/approved-checkouts'
    while read -l root
      if test -n "$root"; and test (string sub -l (string length -- "$root/") -- "$PWD/") = "$root/"
        set approved 1
        break
      end
    end < '/home/test/.envden/state/approved-checkouts'
  end
  test $approved = 1; or return
  test ! -f "$cache"; or cat -- "$cache"
  set -l modified (stat -f %m "$cache" 2>/dev/null; or stat -c %Y "$cache" 2>/dev/null; or echo 0)
  if test (math (date +%s) - $modified) -gt 60
    env -u BUN_OPTIONS -u BUN_BE_BUN '/opt/envden'\\''s bin/envden' status --refresh-cache </dev/null >/dev/null 2>&1 &
    disown
  end
end
_envden_notice
# <<< envden <<<
"
`;

exports[`powershell hook snapshot 1`] = `
"# >>> envden >>>
if (!$global:EnvdenPreviousPrompt) { $global:EnvdenPreviousPrompt = $function:prompt }
function global:prompt {
  $cache = '/home/test/.envden/state/notice'
  $approved = @(Get-Content -LiteralPath '/home/test/.envden/state/approved-checkouts' -ErrorAction SilentlyContinue | Where-Object { $_ -and (($PWD.Path.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar).StartsWith($_.TrimEnd('/','\\') + [IO.Path]::DirectorySeparatorChar, $(if ($IsWindows) { [StringComparison]::OrdinalIgnoreCase } else { [StringComparison]::Ordinal }))) }).Count -gt 0
  if ($approved) {
    if (Test-Path -LiteralPath $cache) { Get-Content -LiteralPath $cache | Out-Host }
    if (!(Test-Path -LiteralPath $cache) -or ((Get-Date) - (Get-Item -LiteralPath $cache).LastWriteTime).TotalSeconds -gt 60) {
      $info = [Diagnostics.ProcessStartInfo]::new('/opt/envden''s bin/envden')
      $info.ArgumentList.Add('status'); $info.ArgumentList.Add('--refresh-cache')
      $info.UseShellExecute = $false; $info.CreateNoWindow = $true
      $info.Environment.Remove('BUN_OPTIONS'); $info.Environment.Remove('BUN_BE_BUN')
      $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true
      $process = [Diagnostics.Process]::Start($info)
      $process.Dispose()
    }
  }
  & $global:EnvdenPreviousPrompt
}
# <<< envden <<<
"
`;
