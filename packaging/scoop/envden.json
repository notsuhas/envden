{
  "version": "{{VERSION}}",
  "homepage": "https://envden.theclau.de",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/notsuhas/envden/releases/download/v{{VERSION}}/envden-windows-x64.exe",
      "hash": "{{SHA256_WINDOWS_X64}}",
      "bin": [["envden-windows-x64.exe", "envden"]]
    },
    "arm64": {
      "url": "https://github.com/notsuhas/envden/releases/download/v{{VERSION}}/envden-windows-arm64.exe",
      "hash": "{{SHA256_WINDOWS_ARM64}}",
      "bin": [["envden-windows-arm64.exe", "envden"]]
    }
  },
  "post_install": [
    "$homeDir = if ($env:ENVDEN_HOME) { $env:ENVDEN_HOME } else { Join-Path $env:USERPROFILE '.envden' }",
    "New-Item -ItemType Directory -Force $homeDir | Out-Null",
    "Set-Content -Path (Join-Path $homeDir 'install-method') -Value 'scoop' -NoNewline"
  ]
}
