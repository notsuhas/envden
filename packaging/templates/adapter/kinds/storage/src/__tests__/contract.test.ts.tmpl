import { storageContract } from "@envden/testing/storage";
import { create{{Impl}}StorageAdapter } from "../index.ts";

storageContract("{{Impl}}", () => {
  let storage = create{{Impl}}StorageAdapter();

  return {
    storage,
    // Reopen the same data, so the suite can check what survives a restart.
    reopen() {
      storage.close();
      storage = create{{Impl}}StorageAdapter();

      return storage;
    },
    dispose() {
      storage.close();
