{
  "name": "@envden/cli",
  "version": "0.3.0",
  "private": true,
  "bin": {
    "envden": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bun build --define __ENVDEN_TELEMETRY_KEY__=\"$(bun -e 'process.stdout.write(JSON.stringify(process.env.ENVDEN_TELEMETRY_KEY ?? \"\"))')\" --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig ./src/main.ts --outfile dist/envden",
    "build:all": "bun scripts/build-all.ts",
    "release:checksums": "bun ../../scripts/release/checksums.ts",
    "packaging:npm:install": "node ../../packaging/npm/install.js",
    "packaging:npm:smoke": "node ../../packaging/npm/bin/launch.js --version"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@commander-js/extra-typings": "15.1.0",
    "@date-fns/tz": "1.5.0",
    "@envden/adapter-keychain-os": "workspace:*",
    "@envden/adapter-network-tailscale": "workspace:*",
    "@envden/adapter-placement-fs": "workspace:*",
    "@envden/adapter-repo-git": "workspace:*",
    "@envden/adapter-shell-rc": "workspace:*",
    "@envden/core": "workspace:*",
    "@envden/server": "workspace:*",
    "commander": "15.1.0",
    "date-fns": "4.4.0",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@envden/testing": "workspace:*"
  }
}
