{
  "name": "envden",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/core",
    "packages/testing",
    "packages/adapters/*/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "bun test",
    "fallow": "fallow",
    "new-adapter": "bun scripts/new-adapter.ts",
    "docs:cli": "bun apps/cli/scripts/cli-reference.ts",
    "ci": "vp check && bun test && fallow --fail-on-issues",
    "changeset": "changeset",
    "release:version": "changeset version && bun scripts/release/sync-version.ts && bun install && vp check --fix"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "fallow": "3.42.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.0"
}
